# Configuration Environnement - EduGestion Africa SaaS

# 1. Base de données PostgreSQL Multi-Tenant
DATABASE_URL="postgresql://postgres:password@localhost:5432/edugestion_africa?schema=public"

# 2. NextAuth / Authentification Sécurisée
NEXTAUTH_SECRET="edugestion-africa-super-secret-key-2025"
NEXTAUTH_URL="http://localhost:3000"

# 3. Passerelles Mobile Money (UEMOA / CEMAC)
WAVE_API_KEY="wave_live_xxxxxxxxx"
WAVE_WEBHOOK_SECRET="whsec_xxxxxxxxx"
ORANGE_MONEY_CLIENT_ID="om_client_xxxxxxxxx"
ORANGE_MONEY_CLIENT_SECRET="om_secret_xxxxxxxxx"

# 4. Passerelles SMS Afrique (Twilio / Orange SMS API / Infobip)
SMS_PROVIDER="ORANGE_SMS_SN"
ORANGE_SMS_AUTH_HEADER="Bearer xxxxxxxxx"
SMS_SENDER_ID="EduGestion"

# 5. Stockage Documents S3 / Cloudflare R2
S3_BUCKET_NAME="edugestion-documents"
S3_REGION="auto"
S3_ACCESS_KEY="xxxxxxxx"
S3_SECRET_KEY="xxxxxxxx"
S3_ENDPOINT="https://xxxx.r2.cloudflarestorage.com"

# 6. Supabase (Bases de données & Realtime / Auth / Storage)
NEXT_PUBLIC_SUPABASE_URL="https://votre-projet.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="votre-cle-anon-supabase"

